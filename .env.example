# ==============================================================================
# DigitalX Solutions - Employee CRM & Google Voice Operations Platform
# Environment Configuration (.env.example)
# ==============================================================================

# Application URL & Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digitalx_crm?schema=public"

# ------------------------------------------------------------------------------
# 2. ENCRYPTION AT REST (Restricted Admin Vault: CNIC, Bank Details)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal secret for AES-256-GCM encryption/decryption
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super-secret-jwt-signing-key-for-session-tokens-digitalx"

# ------------------------------------------------------------------------------
# 3. GOOGLE WORKSPACE & GOOGLE VOICE INTEGRATION (Mode A)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials (with Workspace Voice & Gmail Scopes)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-yourGoogleClientSecret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_WORKSPACE_ADMIN_EMAIL="admin@digitalx-solutions.com"

# BigQuery Voice Export & Ingestion Config (Google Voice Standard/Premier Call Logs)
GOOGLE_BIGQUERY_PROJECT_ID="digitalx-telephony-prod"
GOOGLE_BIGQUERY_DATASET_ID="google_voice_logs"
GOOGLE_BIGQUERY_TABLE_ID="call_records"

# ------------------------------------------------------------------------------
# 4. SIP LINK & WEBRTC BROWSER SOFTPHONE (Mode B)
# ------------------------------------------------------------------------------
# Google Voice SIP Link / Twilio / Kamailio / Asterisk SIP Trunking configuration
SIP_DOMAIN="sip.digitalx-solutions.com"
SIP_OUTBOUND_PROXY="sip:proxy.digitalx-solutions.com:5060"
SIP_WSS_SERVER="wss://sip.digitalx-solutions.com:8089/ws"
SIP_USERNAME="digitalx_trunk_agent"
SIP_PASSWORD="YourSecureSipTrunkPassword"

# Twilio Voice / SIP Trunking Fallback credentials (Optional for browser WebRTC)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_API_KEY="SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_API_SECRET="your_twilio_api_secret"
TWILIO_TWIML_APP_SID="APXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (AWS S3 / Cloudflare R2 / Supabase Storage)
# ------------------------------------------------------------------------------
# S3-compatible bucket for dual-channel audio recordings & encrypted agreement PDFs
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="AKIAEXAMPLEACCESSKEY"
S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
S3_BUCKET_NAME="digitalx-call-recordings"
S3_PUBLIC_DOMAIN="https://recordings.digitalx-solutions.com"

# ------------------------------------------------------------------------------
# 6. POST-CALL AI PIPELINE & N8N WEBHOOK AUTOMATION
# ------------------------------------------------------------------------------
# Webhook URL invoked on completed calls for transcription, summaries & sentiment
N8N_WEBHOOK_URL="https://n8n.digitalx-solutions.com/webhook/call-completed"
N8N_WEBHOOK_SECRET="whsec_digitalx_postcall_automation_token_98765"

# Direct Gemini or OpenAI API Key for fallback transcription and 3-bullet summaries
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
OPENAI_API_KEY="sk-proj-yourOpenAiApiKeyHere"
